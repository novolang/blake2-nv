// blake2b_tests.nv — the 64-bit half, in word algebra, against
// RFC 7693's own constants.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: blake2-nv.blake2b.<fn>`.
// That is the expected result until the bodies land.
//
// THE CONSTANTS ARE THE STANDARD'S.  Every number below is RFC 7693's
// with its section named beside it, so a failing assertion says which
// paragraph of the specification the implementation disagrees with.
// The digest vectors are in `b2bytes_tests.nv`, because a digest is
// `Bytes` and this module has none.
//
// FIVE OF THE EIGHT IV WORDS HAVE THE HIGH BIT SET and `Int` is
// signed, so they are written here as the decimals the source has to
// write, with the hex in a comment.  crypto-nv's `sha512_core` spells
// the same five the same way.

use std.test
use b2param
use blake2b

// `n` copies of `b`, fed one at a time.  A recursion rather than an
// index loop because there is no list here to walk — this is a device's
// read-a-byte loop, written the way the package expects it to be
// written.
fn feed_n(st: B2bState, b: Int, n: Int) -> B2bState
    if n <= 0
        st
    else
        feed_n(blake2b.feed_byte(st, b), b, n - 1)

@test
fn test_the_sizes_are_rfc_7693_section_2_1() [io]
    test.case("eight chaining words, sixteen block words, 128 bytes, twelve rounds")
    test.assert_eq(blake2b.B2B_STATE_WORDS, 8)
    test.assert_eq(blake2b.B2B_BLOCK_WORDS, 16)
    test.assert_eq(blake2b.B2B_BLOCK_BYTES, 128)
    test.assert_eq(blake2b.B2B_WORK_WORDS, 16)
    test.assert_eq(blake2b.B2B_ROUNDS, 12)
    test.assert_eq(blake2b.B2B_DIGEST_BYTES_MOST, 64)

@test
fn test_the_iv_is_sha_512s_rfc_7693_section_2_6() [io]
    test.case("the eight words, in order")
    test.assert_eq(blake2b.iv(0), 0x6A09E667F3BCC908)
    test.assert_eq(blake2b.iv(1), -4942790177534073029)   // 0xBB67AE8584CAA73B
    test.assert_eq(blake2b.iv(2), 0x3C6EF372FE94F82B)
    test.assert_eq(blake2b.iv(3), -6534734903238641935)   // 0xA54FF53A5F1D36F1
    test.assert_eq(blake2b.iv(4), 0x510E527FADE682D1)
    test.assert_eq(blake2b.iv(5), -7276294671716946913)   // 0x9B05688C2B3E6C1F
    test.assert_eq(blake2b.iv(6), 0x1F83D9ABFB41BD6B)
    test.assert_eq(blake2b.iv(7), 0x5BE0CD19137E2179)

@test
fn test_sigma_is_rfc_7693_section_2_7() [io]
    test.case("row 0 is the identity")
    test.assert_eq(blake2b.sigma(0, 0), 0)
    test.assert_eq(blake2b.sigma(0, 7), 7)
    test.assert_eq(blake2b.sigma(0, 15), 15)

    test.case("row 1 is 14 10 4 8 9 15 13 6 1 12 0 2 11 7 5 3")
    test.assert_eq(blake2b.sigma(1, 0), 14)
    test.assert_eq(blake2b.sigma(1, 1), 10)
    test.assert_eq(blake2b.sigma(1, 5), 15)
    test.assert_eq(blake2b.sigma(1, 15), 3)

    test.case("rounds 10 and 11 reuse rows 0 and 1 — the line a port skips")
    // Twelve rounds over a ten-row table.  A port that indexes the
    // table by the round number and stops at ten produces a hash that
    // is right for BLAKE2s and wrong for BLAKE2b.
    test.assert_eq(blake2b.sigma(10, 3), blake2b.sigma(0, 3))
    test.assert_eq(blake2b.sigma(11, 3), blake2b.sigma(1, 3))

@test
fn test_the_rotations_are_32_24_16_63() [io]
    test.case("RFC 7693 section 2.1's R1..R4")
    test.assert_eq(blake2b.rotation(0), 32)
    test.assert_eq(blake2b.rotation(1), 24)
    test.assert_eq(blake2b.rotation(2), 16)
    test.assert_eq(blake2b.rotation(3), 63)

    test.case("rotr is a 64-bit rotate, so rotating 1 right by 1 sets the top bit")
    // 0x8000000000000000 as the decimal a signed Int has to spell.
    test.assert_eq(blake2b.rotr(1, 1), -9223372036854775808)
    test.assert_eq(blake2b.rotr(0, 7), 0)
    test.assert_eq(blake2b.rotr(blake2b.rotr(0x0123456789abcdef, 24), 40), 0x0123456789abcdef)

@test
fn test_a_fresh_state_is_the_iv_xor_the_parameter_block() [io]
    test.case("RFC 7693 section 2.6: h[i] = IV[i] XOR the block's word i")
    let p = b2param.sequential(64)
    let st = blake2b.init(p)
    test.assert_eq(blake2b.state_word(st, 0), blake2b.iv(0) ^ b2param.b_word(p, 0))
    test.assert_eq(blake2b.state_word(st, 1), blake2b.iv(1))
    test.assert_eq(blake2b.state_word(st, 7), blake2b.iv(7))

    test.case("and the counter, the flags and the buffer start at zero")
    test.assert_eq(blake2b.counter_low(st), 0)
    test.assert_eq(blake2b.counter_high(st), 0)
    test.assert(not blake2b.is_last(st))
    test.assert(not blake2b.is_last_node(st))
    test.assert_eq(blake2b.buffered(st), 0)

    test.case("the digest length rides in the state, not in the finish call")
    test.assert_eq(blake2b.digest_length(blake2b.init(b2param.sequential(32))), 32)
    test.assert_eq(blake2b.digest_length(blake2b.init(b2param.sequential(33))), 33)

    test.case("two digest lengths give two different initial states")
    // The assertion that says BLAKE2b-256 is not BLAKE2b-512
    // truncated, at the earliest point it can be said.
    test.assert(blake2b.state_word(blake2b.init(b2param.sequential(32)), 0)
                != blake2b.state_word(blake2b.init(b2param.sequential(64)), 0))

@test
fn test_the_block_is_filled_little_endian() [io]
    test.case("byte j lives at bits 8*(j mod 8) of word j/8")
    var st = blake2b.zero_state()
    st = blake2b.with_block_byte(st, 0, 0x11)
    st = blake2b.with_block_byte(st, 1, 0x22)
    st = blake2b.with_block_byte(st, 8, 0x33)
    test.assert_eq(blake2b.block_byte(st, 0), 0x11)
    test.assert_eq(blake2b.block_byte(st, 1), 0x22)
    test.assert_eq(blake2b.block_word(st, 0) & 0xffff, 0x2211)
    test.assert_eq(blake2b.block_word(st, 1) & 0xff, 0x33)

    test.case("a word written whole reads back byte by byte the same way")
    let w = blake2b.with_block_word(blake2b.zero_state(), 0, 0x0807060504030201)
    test.assert_eq(blake2b.block_byte(w, 0), 0x01)
    test.assert_eq(blake2b.block_byte(w, 7), 0x08)

    test.case("zero_tail clears from `buffered` to the end and leaves the rest")
    let z = blake2b.zero_tail(blake2b.with_buffered(w, 1))
    test.assert_eq(blake2b.block_byte(z, 0), 0x01)
    test.assert_eq(blake2b.block_byte(z, 1), 0)
    test.assert_eq(blake2b.block_word(z, 15), 0)

@test
fn test_the_counter_carries_at_two_to_the_sixty_four() [io]
    test.case("adding within the low half stays in the low half")
    let st = blake2b.add_counter(blake2b.zero_state(), 128)
    test.assert_eq(blake2b.counter_low(st), 128)
    test.assert_eq(blake2b.counter_high(st), 0)

    test.case("a counter set outright reads back")
    let c = blake2b.with_counter(blake2b.zero_state(), 7, 3)
    test.assert_eq(blake2b.counter_low(c), 7)
    test.assert_eq(blake2b.counter_high(c), 3)

    test.case("the carry out of the low half lands in the high one")
    // The low half is already at 2^64-1 spelled as -1; one more byte
    // has to move the high word.
    test.assert_eq(blake2b.counter_high(blake2b.add_counter(blake2b.with_counter(blake2b.zero_state(), -1, 0), 1)),
        1)

@test
fn test_the_flags_are_all_ones_and_are_separate() [io]
    test.case("mark_last sets f0 and leaves f1")
    let st = blake2b.mark_last(blake2b.zero_state())
    test.assert(blake2b.is_last(st))
    test.assert(not blake2b.is_last_node(st))

    test.case("mark_last_node sets f1 and leaves f0")
    let n = blake2b.mark_last_node(blake2b.zero_state())
    test.assert(not blake2b.is_last(n))
    test.assert(blake2b.is_last_node(n))

@test
fn test_the_working_vector_is_h_then_the_iv_with_t_and_f_folded_in() [io]
    test.case("RFC 7693 section 3.2: v[0..7] = h, v[8..15] = IV")
    let st = blake2b.with_counter(blake2b.init(b2param.sequential(64)), 5, 0)
    let w = blake2b.work(st)
    test.assert_eq(blake2b.work_word(w, 0), blake2b.state_word(st, 0))
    test.assert_eq(blake2b.work_word(w, 7), blake2b.state_word(st, 7))
    test.assert_eq(blake2b.work_word(w, 8), blake2b.iv(0))
    test.assert_eq(blake2b.work_word(w, 11), blake2b.iv(3))

    test.case("v[12] is IV[4] XOR t0 and v[13] is IV[5] XOR t1")
    test.assert_eq(blake2b.work_word(w, 12), blake2b.iv(4) ^ 5)
    test.assert_eq(blake2b.work_word(w, 13), blake2b.iv(5))

    test.case("v[14] is IV[6] XOR f0, which is the ONLY thing the last block changes")
    let last = blake2b.work(blake2b.mark_last(st))
    test.assert(blake2b.work_word(last, 14) != blake2b.work_word(w, 14))
    test.assert_eq(blake2b.work_word(last, 15), blake2b.work_word(w, 15))

    test.case("a working word can be set, which is what `g` and `round` do")
    test.assert_eq(blake2b.work_word(blake2b.with_work_word(w, 3, 99), 3), 99)

@test
fn test_g_and_round_and_compress_move_the_state() [io]
    test.case("G at the first column changes lane 0")
    let st = blake2b.init(b2param.sequential(64))
    let w = blake2b.work(st)
    test.assert(blake2b.work_word(blake2b.g(w, 0, 4, 8, 12, 0, 0), 0)
                != blake2b.work_word(w, 0))

    test.case("a full round changes every lane")
    let r = blake2b.round(w, st, 0)
    test.assert(blake2b.work_word(r, 0) != blake2b.work_word(w, 0))
    test.assert(blake2b.work_word(r, 15) != blake2b.work_word(w, 15))

    test.case("compress feeds the vector forward into h and empties the buffer")
    let c = blake2b.compress(blake2b.with_buffered(st, 128))
    test.assert(blake2b.state_word(c, 0) != blake2b.state_word(st, 0))
    test.assert_eq(blake2b.buffered(c), 0)

@test
fn test_blake2_buffers_lazily_which_is_the_rule_a_port_breaks() [io]
    test.case("128 bytes fed leaves a FULL buffer and an unmoved counter")
    // The rule: a full block is not compressed when it fills, because
    // it might be the last one and the last one is compressed with f0
    // set.  A port that compresses eagerly is wrong on exactly the
    // inputs whose length is a multiple of 128.
    let st = feed_n(blake2b.init(b2param.sequential(64)), 0x61, 128)
    test.assert_eq(blake2b.buffered(st), 128)
    test.assert_eq(blake2b.counter_low(st), 0)

    test.case("the 129th byte is what compresses the first block")
    let more = blake2b.feed_byte(st, 0x62)
    test.assert_eq(blake2b.buffered(more), 1)
    test.assert_eq(blake2b.counter_low(more), 128)

    test.case("finishing at 128 instead advances the counter by 128 and sets f0")
    let done = blake2b.finish(st)
    test.assert_eq(blake2b.counter_low(done), 128)
    test.assert(blake2b.is_last(done))

@test
fn test_a_finished_state_reads_out_little_endian() [io]
    test.case("digest byte i is byte i mod 8 of chaining word i/8, low end first")
    let st = blake2b.finish(blake2b.init(b2param.sequential(64)))
    test.assert_eq(blake2b.digest_byte(st, 0), blake2b.state_word(st, 0) & 0xff)
    test.assert_eq(blake2b.digest_byte(st, 8), blake2b.state_word(st, 1) & 0xff)

    test.case("a state can be rebuilt word by word, which is what resuming needs")
    let r = blake2b.with_state_word(blake2b.zero_state(), 3, 0x1122334455667788)
    test.assert_eq(blake2b.state_word(r, 3), 0x1122334455667788)

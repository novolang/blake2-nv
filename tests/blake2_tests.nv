// blake2_tests.nv — the one-shots against RFC 7693, and the RFC's own
// self-test (appendix E), which hashes 24 inputs of 6 lengths at 4 digest
// lengths, keyed and unkeyed, and folds all the digests into one.  The
// two grand hashes below are the RFC's published values, so a pass here is
// a pass against the standard and not only against another program.

use std.bytes
use std.test
use b2param
use b2bytes
use blake2b
use blake2s

fn hex(s: Str) -> Bytes
    bytes.from_hex(s) ?? bytes.zeros(0)

fn abc() -> Bytes
    bytes.from_str("abc")

// RFC 7693 appendix A: BLAKE2b-512 of "abc".
@test
fn test_blake2b_512_of_abc_is_the_rfc_7693_appendix_a_value() [io]
    match b2bytes.blake2b_into(abc(), bytes.zeros(64))
        Ok(d)  => test.assert_eq_str(bytes.to_hex(d),
            "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923")
        Err(e) => test.fail(e.message())

// RFC 7693 appendix B: BLAKE2s-256 of "abc".
@test
fn test_blake2s_256_of_abc_is_the_rfc_7693_appendix_b_value() [io]
    match b2bytes.blake2s_into(abc(), bytes.zeros(32))
        Ok(d)  => test.assert_eq_str(bytes.to_hex(d), "508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982")
        Err(e) => test.fail(e.message())

// Well-known short values: the empty message at the default lengths.
@test
fn test_the_empty_message_has_the_published_digests() [io]
    test.case("BLAKE2b-512")
    match b2bytes.blake2b_into(bytes.zeros(0), bytes.zeros(64))
        Ok(d)  => test.assert_eq_str(bytes.to_hex(d),
            "786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce")
        Err(e) => test.fail(e.message())
    test.case("BLAKE2s-256")
    match b2bytes.blake2s_into(bytes.zeros(0), bytes.zeros(32))
        Ok(d)  => test.assert_eq_str(bytes.to_hex(d), "69217a3079908094e11121d042354a7c1f55b6482ca1a51e1b250dfd1ed0eef9")
        Err(e) => test.fail(e.message())

// RFC 7693 appendix E's input generator: a Fibonacci-like sequence, 32 bits.
fn selftest_seq(n: Int, seed: Int) -> Bytes
    var a = (0xDEAD4BAD * seed) & 0xFFFFFFFF
    var b = 1
    var out = bytes.zeros(n)
    for i in 0..n
        let t = (a + b) & 0xFFFFFFFF
        a = b
        b = t
        out = bytes.set_u8(out, i, (t >>> 24) & 0xFF)
    out

fn digest_b(msg: Bytes, key: Bytes, n: Int) -> Bytes
    match b2bytes.blake2b_keyed_into(key, msg, bytes.zeros(n))
        Ok(d)  => d
        Err(_) => bytes.zeros(0)

fn digest_s(msg: Bytes, key: Bytes, n: Int) -> Bytes
    match b2bytes.blake2s_keyed_into(key, msg, bytes.zeros(n))
        Ok(d)  => d
        Err(_) => bytes.zeros(0)

// RFC 7693 appendix E, BLAKE2b: the grand hash is BLAKE2b-256 over the
// concatenated digests, streamed through the update functions.
@test
fn test_the_rfc_7693_blake2b_self_test_gives_the_published_grand_hash() [io]
    var grand = blake2b.init(b2param.sequential(32))
    for md in [20, 32, 48, 64]
        for il in [0, 3, 128, 129, 255, 1024]
            let inp = selftest_seq(il, il)
            grand = b2bytes.update_b(grand, digest_b(inp, bytes.zeros(0), md))
            grand = b2bytes.update_b(grand, digest_b(inp, selftest_seq(md, md), md))
    match b2bytes.finish_into_b(grand, bytes.zeros(32))
        Ok(d)  => test.assert_eq_str(bytes.to_hex(d), "c23a7800d98123bd10f506c61e29da5603d763b8bbad2e737f5e765a7bccd475")
        Err(e) => test.fail(e.message())

// RFC 7693 appendix E, BLAKE2s.
@test
fn test_the_rfc_7693_blake2s_self_test_gives_the_published_grand_hash() [io]
    var grand = blake2s.init(b2param.sequential(32))
    for md in [16, 20, 28, 32]
        for il in [0, 3, 64, 65, 255, 1024]
            let inp = selftest_seq(il, il)
            grand = b2bytes.update_s(grand, digest_s(inp, bytes.zeros(0), md))
            grand = b2bytes.update_s(grand, digest_s(inp, selftest_seq(md, md), md))
    match b2bytes.finish_into_s(grand, bytes.zeros(32))
        Ok(d)  => test.assert_eq_str(bytes.to_hex(d), "6a411f08ce25adcdfb02aba641451cec53c598b24f4fc787fbdc88797f4c1dfe")
        Err(e) => test.fail(e.message())

// BLAKE2b-256 is not BLAKE2b-512 truncated (RFC 7693 section 2.5): the
// digest length is part of the initial state.
@test
fn test_a_shorter_digest_is_not_a_prefix_of_a_longer_one() [io]
    let long = digest_b(abc(), bytes.zeros(0), 64)
    let short = digest_b(abc(), bytes.zeros(0), 32)
    test.assert_eq(bytes.len(short), 32)
    test.assert(bytes.to_hex(short) != bytes.to_hex(bytes.slice(long, 0, 32)))
    let long_s = digest_s(abc(), bytes.zeros(0), 32)
    let short_s = digest_s(abc(), bytes.zeros(0), 16)
    test.assert(bytes.to_hex(short_s) != bytes.to_hex(bytes.slice(long_s, 0, 16)))

// A keyed hash of the empty message still compresses the key block once
// (section 3.3).  hashlib: blake2b(b"", key=bytes(range(64))).
@test
fn test_a_keyed_hash_of_the_empty_message_compresses_the_key_block() [io]
    var key = bytes.zeros(64)
    for i in 0..64
        key = bytes.set_u8(key, i, i)
    match b2bytes.blake2b_keyed_into(key, bytes.zeros(0), bytes.zeros(64))
        Ok(d)  => test.assert_eq_str(bytes.to_hex(d),
            "10ebb67700b1868efb4417987acf4690ae9d972fb7a590c2f02871799aaa4786b5e996e8f0f4eb981fc214b005f42d2ff4233499391653df7aefcbc13fc51568")
        Err(e) => test.fail(e.message())

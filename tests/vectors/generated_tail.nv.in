// ── Tests over the rows ──────────────────────────────────────────────

fn fail_with(e: B2Error)
    test.fail(e.message())

@test
fn test_blake2b_matches_hashlib_on_every_row() [io]
    var i = 0
    for r in rows_b()
        test.case("row ${i}: ${bytes.len(hex(r[4]))} bytes over ${bytes.len(hex(r[0]))}")
        let msg = hex(r[0])
        let key = hex(r[1])
        let n = bytes.len(hex(r[4]))
        let p = b2bytes.params_b(n, key, hex(r[2]), hex(r[3]))
        match b2bytes.blake2b_full_into(p, key, msg, bytes.zeros(n))
            Ok(d) => test.assert_eq_str(bytes.to_hex(d), r[4])
            Err(e) => fail_with(e)
        if bytes.len(hex(r[2])) == 0 and bytes.len(hex(r[3])) == 0
            match b2bytes.blake2b_keyed_into(key, msg, bytes.zeros(n))
                Ok(d) => test.assert_eq_str(bytes.to_hex(d), r[4])
                Err(e) => fail_with(e)
        i = i + 1

